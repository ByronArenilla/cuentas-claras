# Copia este archivo como .env y rellena los valores. NUNCA subas .env a Git.

# Token del bot (créalo con @BotFather en Telegram)
TELEGRAM_BOT_TOKEN=

# Base de datos (fase 1: SQLite local)
DATABASE_URL=sqlite:///./budget.db

# URL de la API que usan el bot y la web
API_URL=http://localhost:8000

# URL pública de la web. La API la usa para armar los enlaces de invitación
# (<WEB_BASE_URL>/unirse/<token>). El puerto es provisional hasta la spec 007.
WEB_BASE_URL=http://localhost:8080

# Zona horaria para calcular a qué mes pertenece un gasto
TZ=America/Bogota

# Secreto compartido entre la API y el bot (spec 005). Con él, el bot vincula
# chats y pide sesiones en nombre de sus usuarios: trátalo como una contraseña.
# Mínimo 32 caracteres. Genera uno con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
BOT_API_KEY=
